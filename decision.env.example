# Service process environment. Not loaded automatically. No API calls by default.
DECISION_PROVIDER=ollama
DECISIONS_API_ENABLED=false
DECISION_SHADOW_MODE=true
DECISION_TIMEOUT_MS=1200
DECISION_MAX_RETRIES=1
DECISION_API_CALLS_APPROVED=false
OLLAMA_DECISION_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_DECISION_MODEL=tev1:0.8b
OLLAMA_KEEP_ALIVE=10m
OLLAMA_TIMEOUT_MS=1200
LUNA_MODEL=gpt-6-luna
LUNA_REASONING_EFFORT=none
# OPENAI_API_KEY: supply privately to process, never put into tracked files.
